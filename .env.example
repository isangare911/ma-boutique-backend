# ═══════════════════════════════════════════════════════════
# DJANGO
# ═══════════════════════════════════════════════════════════

# ⚠️ En DÉVELOPPEMENT : mettre True
#    En PRODUCTION : mettre False
DEBUG=True

# ⚠️ Générer une clé unique par environnement :
#    python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=votre-cle-secrete-ici

# ⚠️ Sans wildcard. Lister les hosts explicitement.
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# ═══════════════════════════════════════════════════════════
# BASE DE DONNÉES
# ═══════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ═══════════════════════════════════════════════════════════
# CACHE (Redis)
# ═══════════════════════════════════════════════════════════
REDIS_URL=redis://default:password@host:6379/0

# ═══════════════════════════════════════════════════════════
# CORS / CSRF
# ═══════════════════════════════════════════════════════════
CORS_ALLOWED_ORIGINS=https://ma-boutique-backend-production.up.railway.app
CSRF_TRUSTED_ORIGINS=https://ma-boutique-backend-production.up.railway.app

# ═══════════════════════════════════════════════════════════
# ORANGE SMS
# ═══════════════════════════════════════════════════════════
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER_NUMBER=
ORANGE_SENDER_NAME=MaBoutique
OTP_EXPIRY_SECONDS=300